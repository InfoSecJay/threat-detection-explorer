{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/sitemap.xml"
    },
    {
      "source": "/sitemap-:section(pages|mitre|actors|detections).xml",
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/sitemap-:section.xml"
    },
    {
      "source": "/detections/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/detection/:id"
    },
    {
      "source": "/mitre/:id(T[\\d.]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/technique/:id"
    },
    {
      "source": "/actors/:id([GS]\\d+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/actor/:id"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/home"
    },
    {
      "source": "/methodology/corpus-health",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/corpus-health"
    },
    {
      "source": "/methodology",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/methodology"
    },
    {
      "source": "/query",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/query"
    },
    {
      "source": "/digest",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/digest"
    },
    {
      "source": "/digest/:week(\\d{4}-w\\d{2})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/digest/:week"
    },
    {
      "source": "/observables/:kind([a-z_]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*"
        }
      ],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/observables/:kind"
    },
    {
      "source": "/((?!api/|assets/|fonts/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' static.cloudflareinsights.com cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/api/docs",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' cdn.jsdelivr.net; style-src 'self' cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/detections/:id",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/mitre/:id(T[\\d.]+)",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/actors/:id([GS]\\d+)",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/methodology/corpus-health",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/methodology",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/query",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/digest",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/digest/:week(\\d{4}-w\\d{2})",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    },
    {
      "source": "/observables/:kind([a-z_]+)",
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ]
    }
  ]
}
