{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "${VITE_API_URL}/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/sitemap.xml"
    },
    {
      "source": "/detections/:id",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*" }],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/detection/:id"
    },
    {
      "source": "/mitre/:id(T[\\d.]+)",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*" }],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/technique/:id"
    },
    {
      "source": "/actors/:id([GS]\\d+)",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*" }],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/actor/:id"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(bot|slack|discord|twitter|facebook|linkedin|whatsapp|telegram|embed|preview|crawler|spider|vkshare|pinterest|quora).*" }],
      "destination": "https://threat-detection-explorer-production.up.railway.app/api/prerender/home"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
